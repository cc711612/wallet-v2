PROJECT_NAME=wallet-v2
# 建議填絕對路徑，避免 docker compose 在不同工作目錄執行時路徑錯誤
# 例如：/opt/apps/wallet-v2
PROJECT_PATH=/absolute/path/to/wallet-v2

# Ports
NGINX_HTTP_PORT=8088
# nginx 對外綁定的位址；前面有 host nginx 反代時設 127.0.0.1，避免 docker DNAT 繞過防火牆直接對外
NGINX_BIND_ADDR=127.0.0.1

# Timezone
TZ=Asia/Taipei

# 注意：應用程式設定（APP_*, DB_*, REDIS_*, QUEUE_CONNECTION, LINE_*, GEMINI_* ...）
# 請放在專案根目錄的 .env（即 ${PROJECT_PATH}/.env），由 Laravel 直接讀取。

# redis 服務的密碼，只給 redis 容器用（最小權限，不灌整份 Laravel .env）。
# 必須與專案根目錄 .env（${PROJECT_PATH}/.env）的 REDIS_PASSWORD 填同一個值，
# 否則 Laravel 連線會跟 redis 容器實際要求的密碼對不上。留空＝沿用現行無密碼行為。
REDIS_PASSWORD=

# web / worker 容器的執行身分（非 root）。主機上 ${PROJECT_PATH}/storage、bootstrap/cache 的擁有者
# 要是同一組，.env 群組要是 APP_GID（./deploy.sh fix-perms 會冪等修正）。改值後需 ./deploy.sh rebuild。
# 預設 10001 是 usongrat 主機上未使用的 UID/GID，避免對應到主機既有帳號。
APP_UID=10001
APP_GID=10001

# 程式碼目錄的掛載模式：ro（預設，container 內無法改寫程式碼）或 rw（緊急退回用，例如需要在容器內 composer install）。
# 不論哪種，storage/ 與 bootstrap/cache/ 都另外以可寫方式掛載。
APP_CODE_MOUNT=ro
