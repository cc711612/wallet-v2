APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# 明細「預設今天」使用的業務時區（app.timezone 仍為 UTC）
APP_BUSINESS_TIMEZONE=Asia/Taipei
# JWT（HS256）簽章金鑰。留空＝沿用 APP_NAME 簽章（相容既有 token）；設定新值後所有舊 JWT 立即失效，使用者需重新登入
JWT_SECRET=
# 驗證 exp/nbf 容許的時鐘誤差（秒）
JWT_LEEWAY=60
EXCHANGERATE_URI=
EXCHANGERATE_HISTORY_URI=
EXCHANGERATE_API_KEY=
# 每月自動建帳／結算指令（config/wallet.php）。注意：改讀 config 前，config:cache 下這些值實際上
# 都被忽略、一律使用程式預設值（58／多多健保／943／13）；上線前請確認正式 .env 的值是預期值
AUTO_WALLET_USER_ID=58
AUTO_WALLET_SEED_TITLE=月固定支出
AUTO_WALLET_SEED_AMOUNT=0
AUTO_WALLET_SEED_CATEGORY_ID=0
# 第三方登入：checkBind 需帶 provider 的 id_token，後端向 LINE／Google 驗證（預設開啟）。
# 前端尚未改送 id_token 前若需暫時關閉，可設 false（關閉期間 social id 冒用風險仍在，僅限過渡期）
SOCIAL_LOGIN_VERIFY_TOKEN=true
LINE_LOGIN_CHANNEL_ID=
# Google OAuth client id，可多個以逗號分隔（web／iOS／Android）
GOOGLE_LOGIN_CLIENT_IDS=
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_API_VERSION=v1beta
GEMINI_DEFAULT_MODEL=gemini-2.0-flash
NOTIFICATION_SERVICE_URL=
NOTIFICATION_SERVICE_KEY=
LINE_BOT_TOKEN=
# 必填：LINE Messaging API channel secret。/api/webhook/line 簽章驗證為 fail-closed，未設定時所有 webhook 一律 401
LINE_BOT_SECRET=
LINE_ADMIN_USERID=
# /api/webhook/line/notify 內部推播轉發的共享密鑰（呼叫端帶 X-Notify-Relay-Key header）；留空＝此路由一律 401
LINE_NOTIFY_RELAY_KEY=
EASYSPLIT_APP_URL=https://easysplit.usongrat.tw
EASYSPLIT_LOGO_PATH=/images/logo.png
EASYSPLIT_FRAME_ICON_PATH=/assets/images/Frame.svg
EASYSPLIT_BOT_ID=Easysplit-App

# Telescope：預設關閉，正式環境請維持 false；非 local 環境只允許白名單 IP 存取儀表板
TELESCOPE_ENABLED=false
TELESCOPE_ALLOWED_IPS=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
# 必須大於 queue worker 的 --timeout（120 秒）；正式環境若有設定此值，請確認不小於 180
REDIS_QUEUE_RETRY_AFTER=180

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
